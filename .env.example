# Veritas AI - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# API Keys
# OpenAI API Key (required for embeddings and LLM)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, for Claude models)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neo4j Database Connection (required for graph search)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================================================
# OPTIONAL SETTINGS (with defaults)
# =============================================================================

# API Provider (openai or anthropic)
# Change this to switch between providers
API_PROVIDER=openai

# LLM Models for answer generation and reranking
# OpenAI Model (default: gpt-4o-mini - cost-effective option)
LLM_MODEL=gpt-4o-mini

# Anthropic Model (used when API_PROVIDER=anthropic)
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Text Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Search Settings
TOP_K=8
SIMILARITY_THRESHOLD=0.0
RERANK=true
GENERATE_ANSWER=true

# Hybrid Search Settings
RRF_K=60

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000

# Local Embeddings Fallback (if API unavailable)
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Settings
PORT=5000
FLASK_DEBUG=false

# Verbose Error Messages
VERBOSE=false
